# Exemplo de variáveis de ambiente para o backend FinTrack
MONGODB_URI=
# Para MongoDB Atlas com AWS IAM Roles, use uma URI sem usuario/senha e habilite:
# MONGODB_URI=
# MONGODB_AUTH_MECHANISM=MONGODB-AWS
# AWS_REGION=us-east-1
# Em desenvolvimento local, se necessario, use tambem:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
JWT_SECRET=uma_chave_secreta_forte_para_dev
JWT_REFRESH_SECRET=uma_outra_chave_secreta_forte_para_dev
PORT=4000

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
